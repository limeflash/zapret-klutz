# Окончания строк. В репозитории всегда LF, в рабочей копии — как указано
# ниже. Без этих правил файл, сохранённый другим редактором, давал дифф на
# весь файл: так renderer.js и index.html однажды «изменились» целиком, и
# настоящие правки в них стало не разглядеть.
* text=auto

# Фронтенд и скрипты Windows правятся в редакторах, которые ставят CRLF.
*.js   text eol=crlf
*.html text eol=crlf
*.css  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf

*.rs   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml  text eol=lf
*.py   text eol=lf
*.svg  text eol=lf

*.png binary
*.ico binary
*.exe binary

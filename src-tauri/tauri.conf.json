{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Klutz",
  "version": "1.1.0",
  "identifier": "com.vbu00.klutz",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Klutz",
        "width": 1040,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": ["bin/TgWsProxyHeadless.exe"]
  }
}
